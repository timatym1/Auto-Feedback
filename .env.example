# Core Config
ENV=development
DEBUG=true
CREATOR_ID=123456789

# Telegram Bot Setup
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_123456
USE_WEBHOOK=false
WEBHOOK_HOST=https://feedback.yourdomain.com
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=super-secret-webhook-key

# App Server
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET=super-secret-jwt-key
JWT_ALGORITHM=HS256

# PostgreSQL Database
POSTGRES_USER=nps_user
POSTGRES_PASSWORD=nps_password_secure
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nps_engine_db

# Redis Cache & Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0